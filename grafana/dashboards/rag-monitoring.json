{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queries per Day",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, count(*) FROM regulatory.conversations WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Queries",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS total FROM regulatory.conversations",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "User Feedback (👍/👎)",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(feedback, 'none') AS feedback, count(*) FROM regulatory.conversations GROUP BY 1",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens per Query",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, usage_tokens FROM regulatory.conversations WHERE $__timeFilter(created_at) ORDER BY 1",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Prompt Version",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT prompt_version, count(*) FROM regulatory.conversations GROUP BY 1",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Most Cited Documents",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT doc_id, count(*) AS n FROM regulatory.conversations, jsonb_to_recordset(docs) AS r(doc_id text) GROUP BY 1 ORDER BY n DESC LIMIT 10",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Avg Tokens / Query",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(usage_tokens)) AS avg_tokens FROM regulatory.conversations WHERE usage_tokens IS NOT NULL",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Avg Docs Cited",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(jsonb_array_length(docs))) AS avg_docs FROM regulatory.conversations",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Positive Feedback (%)",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(ROUND(100.0 * count(*) FILTER (WHERE feedback = 'up') / NULLIF(count(*) FILTER (WHERE feedback IS NOT NULL), 0), 1), 0) AS pct FROM regulatory.conversations",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Recent Conversations (Detail)",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, query, LEFT(answer, 300) AS answer_preview, prompt_version, model, usage_tokens, CASE feedback WHEN 'up' THEN '👍 up' WHEN 'down' THEN '👎 down' ELSE '—' END AS feedback, (SELECT string_agg(doc_id, ', ') FROM jsonb_to_recordset(docs) AS r(doc_id text)) AS cited_docs FROM regulatory.conversations ORDER BY created_at DESC LIMIT 50",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "answer_preview" },
            "properties": [
              { "id": "custom.width", "value": 500 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "query" },
            "properties": [
              { "id": "custom.width", "value": 250 }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Nyawa Avg Relevance",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(ROUND(AVG(avg_score)::numeric, 3), 0) AS avg_rel FROM regulatory.nyawa_recalls",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Nyawa Recall Relevance over Time",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 32 },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, avg_score FROM regulatory.nyawa_recalls WHERE $__timeFilter(created_at) ORDER BY 1",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 3 },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Nyawa Recall Results per Query",
      "datasource": { "type": "postgres", "uid": "PG" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LEFT(query, 40) AS query, n_results, ROUND(avg_score::numeric, 3) AS avg_score FROM regulatory.nyawa_recalls ORDER BY created_at DESC LIMIT 10",
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "PG" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["rag", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "RAG Monitoring",
  "uid": "rag-monitoring",
  "version": 1,
  "weekStart": ""
}
