# --- LLM (OpenAI-compatible API) ---
# Default: DeepSeek (cheap for testing). Swap to OpenRouter/gpt-5.4-mini
# by changing OPENAI_BASE_URL + OPENAI_API_KEY + LLM_MODEL.
OPENAI_API_KEY=sk-your_deepseek_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# Local embedding model (no API key needed)
# multilingual-e5-small (384-dim) — fast on CPU; e5-base (768-dim) if more power
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Jina AI (embeddings + reranker) ---
# Get a key at https://jina.ai (free tier available)
JINA_API_KEY=jina_your_key
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIM=1024
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- Nyawa memory (optional bonus feature) ---
# Binary: download from https://github.com/rezkyauliapratama/nyawa/releases
# (nyawa-linux-amd64.gz, v1.0.0) -> extract to ./nyawa/nyawa
NYAWA_BINARY=./nyawa/nyawa
NYAWA_DB=./data/nyawa_memory.db
# --- PostgreSQL ---
# NOTE: 'localhost' is for local dev mode only. When Streamlit runs in
# Docker, docker-compose.yml overrides DATABASE_URL to use the 'pgvector'
# service hostname automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://rag:***@localhost:5432/rag_db

# --- Streamlit UI ---
STREAMLIT_PORT=8501
APP_PASSWORD=change_me

# --- Nyawa memory layer (optional) ---
NYAWA_BINARY=./nyawa/nyawa
NYAWA_DB=./data/nyawa_memory.db
