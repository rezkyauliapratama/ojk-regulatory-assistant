# --- LLM / Embeddings ---
# OpenRouter (OpenAI-compatible) — main LLM provider
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-5.4-mini

# Local embedding model (no API key needed)
# multilingual-e5-small (384-dim) — fast on CPU; e5-base (768-dim) if more power
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Jina AI (embeddings + reranker) ---
# Get a key at https://jina.ai (free tier available)
JINA_API_KEY=jina_your_key
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIM=1024
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ojk_regulatory
POSTGRES_USER=ojk
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://ojk:change_me@localhost:5432/ojk_regulatory

# --- Streamlit UI ---
STREAMLIT_PORT=8501
APP_PASSWORD=change_me

# --- Nyawa memory layer (optional) ---
NYAWA_BINARY=./nyawa/nyawa
NYAWA_DB=./data/nyawa_memory.db
